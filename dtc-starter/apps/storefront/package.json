{
  "name": "@dtc/storefront",
  "version": "1.0.3",
  "private": true,
  "author": "Kasper Fabricius Kristensen <kasper@medusajs.com> & Victor Gerbrands <victor@medusajs.com> (https://www.medusajs.com)",
  "description": "Next.js Starter to be used with Medusa V2",
  "keywords": [
    "medusa-storefront"
  ],
  "scripts": {
    "dev": "next dev --turbopack -p 8000",
    "build": "node scripts/prepare-original-admin.mjs && next build",
    "start": "next start -p 8000",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "demo": "next build && next start -p 8000",
    "test:migration": "node --import tsx --test tests/*.test.mjs",
    "typecheck:server": "tsc --project tsconfig.server.json",
    "migration:inventory": "node scripts/backend-inventory.mjs",
    "migration:export": "node scripts/export-postgres.mjs",
    "migration:verify": "node scripts/verify-snapshot.mjs",
    "migration:check-db": "node --experimental-strip-types --env-file=.env.local scripts/check-mongodb.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test:integration": "RUN_MONGO_INTEGRATION=true node --env-file=.env.local --import tsx --test tests/*.integration.mjs",
    "test:storage": "RUN_STORAGE_INTEGRATION=true node --env-file=.env.local --import tsx --test tests/*uploads.integration.mjs",
    "migration:check-storage": "node --env-file=.env.local scripts/check-storage.mjs",
    "migration:reconcile": "node --env-file=.env.local scripts/verify-migration.mjs",
    "build:mongodb": "node scripts/prepare-original-admin.mjs && MONGODB_API_PREVIEW=true NEXT_PUBLIC_YARNLY_BACKEND_MODE=mongodb next build",
    "start:mongodb": "MONGODB_API_PREVIEW=true NEXT_PUBLIC_YARNLY_BACKEND_MODE=mongodb next start -p 8000",
    "dev:mongodb": "MONGODB_API_PREVIEW=true NEXT_PUBLIC_YARNLY_BACKEND_MODE=mongodb next dev -p 8000",
    "test:smoke": "node scripts/http-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@headlessui/react": "^2.2.0",
    "@medusajs/icons": "2.21.1",
    "@medusajs/instantsearch-adapter": "2.21.1",
    "@medusajs/js-sdk": "2.21.1",
    "@medusajs/ui-preset": "2.21.1",
    "@payos/node": "^2.0.5",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-slider": "^1.4.7",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "clsx": "^2.1.1",
    "instantsearch.js": "4.113.0",
    "jose": "^6.2.13",
    "lodash": "^4.17.21",
    "mongodb": "^6.21.0",
    "next": "15.5.24",
    "nodemailer": "^7.0.13",
    "pg": "^8.11.3",
    "qrcode": "1.5.4",
    "qs": "^6.12.1",
    "react": "19.0.5",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.0.5",
    "react-instantsearch": "^7.46.0",
    "scrypt-kdf": "^3.0.0",
    "server-only": "^0.0.1",
    "tailwindcss-radix": "^2.8.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@medusajs/types": "2.21.1",
    "@types/lodash": "^4.14.195",
    "@types/node": "17.0.21",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "1.5.5",
    "@types/qs": "^6.15.1",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "@types/react-instantsearch-dom": "^6.12.3",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.4.2",
    "babel-loader": "^8.2.3",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.4.8",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.0.23",
    "tsx": "^4.23.15",
    "typescript": "^5.3.2"
  }
}
