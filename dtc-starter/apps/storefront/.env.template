# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=vn

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=https://localhost:8000

# Stripe publishable key for payment processing (optional, only if using Stripe)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=development

# MongoDB migration preview. Keep false until all existing features pass parity tests.
# These are SERVER-ONLY values: never use a NEXT_PUBLIC_ prefix.
MONGODB_API_PREVIEW=false
# Use mongodb only in a tested preview together with its API URL.
NEXT_PUBLIC_YARNLY_BACKEND_MODE=medusa
MONGODB_URI=
MONGODB_DB=yarnly_staging
# Generate with: node -e 'console.log(require("node:crypto").randomBytes(48).toString("base64url"))'
AUTH_SECRET=

# Used only by the read-only snapshot tool. Do not set this on Vercel.
SOURCE_DATABASE_URL=

# Integrations for the replacement backend. Copy values privately from the
# existing deployment. Configure bucket CORS for direct browser PUT uploads.
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_API_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_TOKEN=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_DELIVERY_ENABLED=false
ADMIN_NOTIFY_EMAIL=
CRON_SECRET=
STOREFRONT_URL=

# PayOS payment credentials (server only; never NEXT_PUBLIC).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Legacy SePay webhook credentials; PayOS is the active provider for new orders.
SEPAY_WEBHOOK_API_KEY=
# Receiving account is read from the existing Admin > Payouts bank settings.


# Educational QR simulation; keep bank for real-money deployments.
# Simulation applies only to newly created orders, persisted per order.
PAYMENT_MODE=bank
# Phone-accessible LAN URL for local testing or deployed HTTPS origin.
QR_PAYMENT_BASE_URL=
